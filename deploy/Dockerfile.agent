# NO PROBADO en esta sesion (no habia demonio Docker). Imagen unica para: bootstrap, 4 servidores MCP (HTTP) y API del agente.
FROM python:3.13-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements-vision.txt requirements-agent.txt ./
RUN pip install --no-cache-dir --prefer-binary -r requirements-agent.txt
COPY src/ src/
COPY services/ services/
COPY scripts/ scripts/
COPY config/ config/
COPY results/ results/
COPY models/protocolo_A/ models/protocolo_A/
ENV VISION_MODEL_DIR=/app/models/protocolo_A VISION_SRC_DIR=/app/src
EXPOSE 8000
CMD ["uvicorn", "--factory", "services.agent_api.app:create_app", "--host", "0.0.0.0", "--port", "8000"]
