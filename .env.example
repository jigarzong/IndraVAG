# Copiar a .env (python scripts/init_env.py lo hace y genera secretos aleatorios). NO versionar .env. Sin secretos en este archivo.

# --- LLM en Azure AI Foundry (orquestador) ---
# Endpoint de la API v1 del recurso: https://<recurso>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=<endpoint de tu despliegue, termina en /openai/v1/>
AZURE_OPENAI_API_KEY=<clave; solo en tu .env local o en secretos de Azure>
AZURE_OPENAI_DEPLOYMENT_NAME=<nombre EXACTO de tu despliegue>
AZURE_OPENAI_API_VERSION=v1
# Clave de config/pricing.json que corresponde al despliegue (las tarifas de gpt-5.4-mini-global son PROVISIONALES: verificar en la pagina oficial)
PRICING_MODEL_KEY=gpt-5.4-mini-global
# Opcional: 0 para respuestas mas repetibles si el despliegue lo acepta (scripts/check_llm.py lo comprueba)
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=

# --- Agente ---
MAX_AGENT_ITERATIONS=4
AGENT_MODE=multi                 # multi (enrutador + especialistas) | single (un agente con las 15 tools)
AGENT_HUB=http                   # http (contenedores / run_stack.py) | stdio | inprocess
AUTH_MODE=demo                   # demo habilita POST /auth/token con usuarios de ejemplo. Cualquier otro valor lo apaga (usar SSO)

# --- Servicio de vision (API propia) y su cliente ---
VISION_SERVICE_URL=http://localhost:8001
VISION_TIMEOUT_SECONDS=5
VISION_RETRIES_5XX=1
VISION_RETRY_WAIT_SECONDS=0.5
VISION_MODEL_DIR=models/protocolo_A
VISION_MAX_IMAGE_BYTES=5242880
VISION_MAX_IMAGES_PER_REQUEST=5
# Umbrales de calidad de imagen (heuristicas con margen sobre COIL-100; ver services/vision_api/quality.py)
VISION_Q_BLUR_MIN=25
VISION_Q_DARK_MAX_MEAN=15
VISION_Q_BRIGHT_MIN_MEAN=180
VISION_Q_CONTRAST_MIN_STD=10
VISION_Q_MIN_SIDE=32
# Solo para la demo de escenarios adversos (5xx o timeout inyectados). Dejar en 0 en cualquier despliegue real.
VISION_FAULT_INJECTION=0
VISION_FAULT_MODE=

# --- Seguridad (minimo 32 caracteres; python scripts/init_env.py los genera) ---
JWT_SECRET=
APPROVAL_SECRET=
APPROVAL_TTL_MINUTES=30

# --- Datos y reglas de negocio de los servidores MCP ---
OPS_DB_PATH=data/ops.db
IMAGE_STORE_DIR=data/uploads
DEMO_TODAY=2026-10-15
TICKET_DEDUP_HOURS=24
SKU_MIN_VIEWS=36
SKU_MAX_ANGLE_GAP_DEG=20
PROMOTION_MIN_ACC_CLASE=0.98
PROMOTION_MIN_PCT_WITHIN_10=0.90

# --- Transporte MCP (run_stack.py y docker compose lo fijan por servicio; stdio para pruebas y evaluacion) ---
MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1  MCP_PORT=8101  MCP_URL_VISION=...  (ver docker-compose.yml)
